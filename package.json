{
  "name": "crm-multicanal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:email": "tsx watch src/workers/email-sync.ts",
    "dev:alerts": "tsx watch src/workers/alert-worker.ts",
    "dev:all": "concurrently -n web,email,alerts -c blue,green,magenta \"npm run dev:web\" \"npm run dev:email\" \"npm run dev:alerts\"",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy",
    "setup": "prisma migrate deploy && tsx scripts/seed.ts",
    "tunnel": "ngrok http 3000",
    "seed": "tsx scripts/seed.ts",
    "demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.5",
    "imapflow": "^2.0.6",
    "mailparser": "^3.9.28",
    "next": "14.2.35",
    "next-auth": "^4.24.15",
    "nodemailer": "^7.0.13",
    "prisma": "^6.19.3",
    "react": "^18",
    "react-dom": "^18",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "dotenv": "^16.4.5",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "typescript": "^5"
  }
}
