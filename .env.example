# App / base de datos
# PostgreSQL (Neon en producción, rama de desarrollo en local).
# Vercel NO soporta SQLite: el filesystem es efímero y de solo lectura.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/DBNAME?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-secret-change-me"
ADMIN_EMAIL="admin@crm.local"
# Si se deja vacío, `npm run seed` usa la contraseña temporal "admin1234"
# (ver docs/credenciales.md para cambiarla).
ADMIN_PASSWORD_HASH_B64=""

# Protege /api/cron/* en producción. Vercel lo envía como
# Authorization: Bearer <CRON_SECRET>. Generar con: openssl rand -base64 32
CRON_SECRET=""

# App Android (Trusted Web Activity). Ambas vacías = sin verificación de dominio.
# Ver docs/apk-android.md.
ANDROID_PACKAGE_NAME=""
ANDROID_SHA256_CERT=""

# Email IMAP (entrada)
EMAIL_IMAP_HOST="imap.gmail.com"
EMAIL_IMAP_PORT="993"
EMAIL_IMAP_USER=""
EMAIL_IMAP_PASSWORD=""
EMAIL_IMAP_SYNC_INTERVAL_MS="30000"
EMAIL_IMAP_LOOKBACK_DAYS="30"

# Email SMTP (salida)
EMAIL_SMTP_HOST="smtp.gmail.com"
EMAIL_SMTP_PORT="465"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""
EMAIL_FROM_NAME="Mi Negocio"

# SLA y alertas
SLA_THRESHOLD_MINUTES="30"
ALERT_CHECK_INTERVAL_MS="60000"
ALERT_EMAIL_TO=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# WhatsApp Meta Cloud API
WA_PHONE_NUMBER_ID=""
WA_BUSINESS_ACCOUNT_ID=""
WA_ACCESS_TOKEN=""
WA_APP_SECRET=""
WA_WEBHOOK_VERIFY_TOKEN=""
WA_GRAPH_VERSION="v24.0"